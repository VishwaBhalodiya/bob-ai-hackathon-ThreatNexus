# ThreatNexus — environment configuration
# Copy to src/backend/.env and fill in your values.  NEVER commit .env.

# ── IBM Bob (the only AI provider used by ThreatNexus) ────────────────────────
# Set BOB_ENABLED=true to have IBM Bob generate every BLUF summary.
# Leave false (or omit credentials) and the deterministic BLUF templates are
# used instead — the full platform still runs offline.
BOB_ENABLED=false

# Bob API key. Create an *Inference-scoped* key in your Bob instance
# (Settings → API Keys).  General keys also work but need BOB_TEAM_ID.
BOB_API_KEY=

# Base URL of your Bob inference endpoint — no trailing slash.
# Requests go to  {BOB_BASE_URL}/v1/chat/completions
BOB_BASE_URL=https://your-bob-host/api

# Model ID available on your Bob instance (e.g. a Granite instruct model).
BOB_MODEL=

# Seconds to wait for Bob before falling back to the template (default 3).
BOB_TIMEOUT=3

# Only required for Bob General (non-Inference) keys.
BOB_TEAM_ID=
