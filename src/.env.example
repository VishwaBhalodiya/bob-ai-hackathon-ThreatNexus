# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# ─── IBM watsonx.ai ──────────────────────────────────────────────────────────
# Required only for AI-assisted threat explanations.
# If absent, the platform uses deterministic template-based explanations.
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ─── Database ─────────────────────────────────────────────────────────────────
# Defaults to SQLite (no setup needed). For PostgreSQL use:
# DATABASE_URL=postgresql://user:password@localhost:5432/threatenexus
DATABASE_URL=sqlite:///./threatenexus.db

# ─── Application ──────────────────────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development
